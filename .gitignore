# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite (sessions, oauth tokens, encrypted api keys)
/data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal

# local test example images
/examples
/public/examples

# local scratch prompts
test_prompt.txt

# python bytecode
**/__pycache__/
*.py[cod]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
